---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const projects = await getCollection('portfolio');
projects.sort((a, b) => b.data.year - a.data.year);
---

<Layout title="Portfolio - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-24 relative z-10">
    
    <header class="mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between border-b border-earth-300 pb-8 animate-fade-up" style="animation-delay: 200ms;">
      <div>
        <h1 class="text-5xl md:text-7xl font-light text-earth-900 tracking-tight mb-2">Selected Works</h1>
        <p class="text-xl text-earth-600 font-light italic">Index of digital craftsmanship.</p>
      </div>
      <span class="text-xs uppercase tracking-[0.2em] text-earth-500 mt-8 md:mt-0">Archive // 2020—2026</span>
    </header>

    <div class="flex flex-col">
      {projects.map((project, index) => (
        <article 
          class="group grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center py-8 border-b border-earth-300 hover:border-earth-800 transition-colors animate-fade-up" 
          style={`animation-delay: ${300 + (index * 100)}ms;`}
        >
          <div class="md:col-span-2 text-earth-400 font-light text-xl md:text-2xl group-hover:text-earth-900 transition-colors">
            {project.data.year}
          </div>
          
          <div class="md:col-span-6">
            <h2 class="text-3xl md:text-4xl font-light text-earth-900 mb-2">
              <a href={`/portfolio/${project.id}`} class="focus:outline-none flex items-center gap-4">
                {project.data.title}
                <span class="opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-earth-500 text-2xl">&rarr;</span>
              </a>
            </h2>
            <p class="text-earth-600 font-light text-lg line-clamp-1">{project.data.description}</p>
          </div>
          
          <div class="md:col-span-4 flex flex-wrap gap-2 justify-start md:justify-end mt-4 md:mt-0">
            {project.data.tags && project.data.tags.map(tag => (
              <span class="text-xs uppercase tracking-[0.1em] text-earth-500 border border-earth-300 px-2 py-1 rounded-sm group-hover:border-earth-500 transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

  </main>
</Layout>
