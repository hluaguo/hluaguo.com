---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { env } from 'cloudflare:workers';

const db = (env as any).OUTPOST_DB;

let projects = [];
try {
  const { results } = await db.prepare('SELECT * FROM portfolio WHERE is_published = 1 ORDER BY year DESC').all();
  projects = results;
} catch (e) {
  console.error('D1 Portfolio Fetch Error:', e);
}
---

<Layout title="Portfolio - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-7xl mx-auto px-8 md:px-16 lg:px-24 py-16 md:py-32 relative z-10">
    
    <header class="mb-24 md:mb-32 flex flex-col md:flex-row md:items-end justify-between border-b border-earth-300 pb-12 animate-fade-up" style="animation-delay: 200ms;">
      <div>
        <h1 class="text-5xl md:text-7xl font-light text-earth-900 tracking-tight mb-2">Selected Works</h1>
        <p class="text-xl text-earth-600 font-light italic">Index of digital craftsmanship.</p>
      </div>
      <span class="text-xs uppercase tracking-[0.2em] text-earth-500 mt-8 md:mt-0">Archive // Cloud Outpost</span>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-24 gap-y-32">
      {projects.length > 0 ? projects.map((project, index) => (
        <article 
          class="group relative flex flex-col animate-fade-up" 
          style={`animation-delay: ${300 + (index * 100)}ms;`}
        >
          <a href={`/portfolio/${project.slug}`} class="block space-y-8 hover-lift">
            <div class="relative aspect-[16/10] overflow-hidden rounded-sm">
              {project.image_path ? (
                <img 
                  src={`/api/media?path=${project.image_path}`} 
                  class="aesthetic-image w-full h-full object-cover scale-[1.01]" 
                  alt={project.title}
                />
              ) : (
                <div class="w-full h-full bg-earth-200 flex items-center justify-center">
                  <span class="text-earth-400 font-serif italic text-lg">No Preview</span>
                </div>
              )}
            </div>

            <div class="space-y-4 px-4">
              <div class="flex justify-between items-baseline gap-6">
                <h2 class="text-3xl md:text-4xl font-light text-earth-900 transition-all duration-500">
                  {project.title}
                </h2>
                <span class="text-xs font-medium text-earth-400 uppercase tracking-[0.3em] whitespace-nowrap">{project.year}</span>
              </div>

              <!-- Expanding description -->
              <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-all duration-700 ease-out-expo overflow-hidden">
                <p class="text-base text-earth-700 font-light leading-relaxed min-h-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-100 pr-8">
                  {project.description}
                </p>
              </div>
              <div class="pt-2 flex items-center gap-2 text-earth-900 font-medium text-[10px] uppercase tracking-widest opacity-0 group-hover:opacity-100 chill-transition translate-y-2 group-hover:translate-y-0">
                <span>Explore Project</span>
                <span class="text-lg font-thin">&rarr;</span>
              </div>
            </div>

          </a>
        </article>
      )) : (

        <div class="text-center py-20 text-earth-400 italic">No works indexed in the cloud yet.</div>
      )}
    </div>

  </main>
</Layout>
