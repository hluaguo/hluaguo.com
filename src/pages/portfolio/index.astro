---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { env } from 'cloudflare:workers';
import { marked } from 'marked';

const db = (env as any).OUTPOST_DB;

let projects = [];
try {
  const { results } = await db.prepare('SELECT * FROM portfolio WHERE is_published = 1 ORDER BY year DESC').all();
  projects = results;
} catch (e) {
  console.error('D1 Portfolio Fetch Error:', e);
}
---

<Layout title="Portfolio - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-7xl mx-auto px-8 md:px-16 lg:px-24 py-16 md:py-32 relative z-10">
    
    <header class="mb-24 md:mb-32 flex flex-col md:flex-row md:items-end justify-between border-b border-earth-300 pb-12 animate-fade-up" style="animation-delay: 200ms;">
      <div>
        <h1 class="text-5xl md:text-7xl font-light text-earth-900 tracking-tight mb-2">Selected Works</h1>
        <p class="text-xl text-earth-600 font-light italic">Index of digital craftsmanship.</p>
      </div>
      <span class="text-xs uppercase tracking-[0.2em] text-earth-500 mt-8 md:mt-0">Archive // Cloud Outpost</span>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-24 md:gap-y-32">
      {projects.length > 0 ? projects.map((project, index) => (
        <article 
          class="group relative flex flex-col animate-fade-up" 
          style={`animation-delay: ${300 + (index * 100)}ms;`}
        >
          <a href={`/portfolio/${project.slug}`} class="block space-y-6">
            <div class="relative aspect-[16/10] overflow-hidden rounded-sm bg-earth-200">
              {project.image_path ? (
                <img 
                  src={`/api/media?path=${project.image_path}`} 
                  class="aesthetic-image w-full h-full object-cover scale-[1.01] group-hover:scale-105 transition-transform duration-1000 ease-out-expo" 
                  alt={project.title}
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-earth-400 font-serif italic text-lg">Work in progress</span>
                </div>
              )}
              <div class="absolute inset-0 bg-earth-900/0 group-hover:bg-earth-900/5 transition-colors duration-700"></div>
            </div>

            <div class="space-y-3 px-1">
              <div class="flex justify-between items-baseline gap-6">
                <h2 class="text-3xl md:text-4xl font-serif font-light text-earth-900 group-hover:text-clay transition-colors duration-500">
                  {project.title}
                </h2>
                <span class="text-[10px] font-bold text-earth-400 uppercase tracking-[0.2em] whitespace-nowrap">{project.year}</span>
              </div>

              <p class="text-earth-600 font-light leading-relaxed line-clamp-2 text-sm group-hover:text-earth-800 transition-colors duration-500">
                {project.description}
              </p>

              <div class="pt-4 flex items-center gap-2 text-earth-900 font-bold text-[9px] uppercase tracking-[0.2em] opacity-0 group-hover:opacity-100 chill-transition translate-y-2 group-hover:translate-y-0">
                <span>View Details</span>
                <span class="text-lg font-thin text-clay group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </div>

          </a>
        </article>
      )) : (

        <div class="text-center py-20 text-earth-400 italic">No works indexed in the cloud yet.</div>
      )}
    </div>

  </main>
</Layout>
