---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
---

<Layout title="Admin Outpost">
  <Navigation />
  
  <main class="flex-grow w-full max-w-4xl mx-auto px-6 py-12 space-y-12">
    <!-- Auth Wall -->
    <div id="auth-wall" class="fixed inset-0 z-[100] bg-earth-100 flex items-center justify-center p-6 hidden">
        <div class="max-w-sm w-full space-y-8 text-center animate-fade-up">
            <div class="space-y-2">
                <h1 class="text-4xl font-light text-earth-900 tracking-tight">Restricted</h1>
                <p class="text-earth-600 italic text-sm">Enter access key to initialize command center.</p>
            </div>
            <div class="space-y-4">
                <input type="password" id="access-key-input" class="w-full bg-transparent border-b border-earth-800 text-center text-2xl py-2 focus:outline-none placeholder:text-earth-300" placeholder="••••••••" />
                <button id="auth-btn" class="w-full bg-earth-800 text-earth-100 py-3 uppercase tracking-widest text-xs font-bold hover:bg-earth-700 transition-all">Establish Connection</button>
            </div>
        </div>
    </div>

    <header class="border-b border-earth-800 pb-8 flex justify-between items-end">
      <div>
        <h1 class="text-5xl font-light text-earth-900 tracking-tight">Admin Portal</h1>
        <p class="text-earth-600 italic">Command center for the digital outpost.</p>
      </div>
      <button id="logout-btn" class="text-[10px] uppercase tracking-[0.2em] text-earth-400 hover:text-earth-800 transition-colors">Terminate Session</button>
    </header>

    <section class="space-y-8 animate-fade-up">
      <div class="bg-earth-200/50 border border-earth-300 p-8 rounded-lg shadow-inner">
        <div class="flex justify-between items-center mb-8 border-b border-earth-300 pb-4">
            <h2 id="form-title" class="text-2xl font-light text-earth-800 uppercase tracking-widest text-sm">Create New Entry</h2>
            <button id="cancel-edit" class="text-[10px] uppercase tracking-widest text-earth-500 hover:text-earth-800 hidden">Cancel Edit &larr;</button>
        </div>
        
        <form id="admin-form" class="space-y-6">
          <input type="hidden" id="record-id" name="id" />
          <input type="hidden" id="existing-image-path" name="existing_image_path" />

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="flex flex-col gap-2">
              <label for="type" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Entry Type</label>
              <select id="type" name="type" required class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors">
                <option value="post">Journal (Post)</option>
                <option value="portfolio">Portfolio (Project)</option>
                <option value="place">Atlas (Map Pin)</option>
              </select>
            </div>
            <div class="flex flex-col gap-2 md:col-span-2">
              <label for="title" id="title-label" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Title</label>
              <input type="text" id="title" name="title" required class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors" />
            </div>
          </div>

          <div id="standard-fields" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label for="slug" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Slug</label>
                <input type="text" id="slug" name="slug" class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors" placeholder="my-new-post" />
              </div>
              <div id="extra-container" class="flex flex-col gap-2">
                <label id="extra-label" for="extra" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Extra (Year for Projects)</label>
                <input type="text" id="extra" name="extra" class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors" placeholder="2026" />
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label for="description" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Short Description</label>
              <textarea id="description" name="description" rows="2" class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors"></textarea>
            </div>
          </div>

          <div id="place-fields" class="space-y-6 hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label for="lat" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Latitude</label>
                <input type="text" id="lat" name="lat" class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors" placeholder="35.0116" />
              </div>
              <div class="flex flex-col gap-2">
                <label for="lng" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Longitude</label>
                <input type="text" id="lng" name="lng" class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 focus:outline-none focus:border-earth-800 transition-colors" placeholder="135.7681" />
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="image" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Featured Image (Upload to R2)</label>
            <div id="current-image-preview" class="hidden mb-4 p-4 border border-earth-300 bg-earth-100 rounded flex items-center gap-4">
                <img id="preview-img" src="" class="w-20 h-20 object-cover border border-earth-300" />
                <span class="text-xs text-earth-500 italic">Current image on cloud. Upload new to replace.</span>
            </div>
            <input type="file" id="image" name="image" accept="image/*" class="text-sm text-earth-700 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-earth-800 file:text-earth-100 hover:file:bg-earth-700" />
          </div>

          <div class="flex flex-col gap-2">
            <label for="content" id="content-label" class="text-xs uppercase tracking-widest text-earth-500 font-bold">Content (Markdown / Note)</label>
            <textarea id="content" name="content" rows="10" required class="bg-earth-100 border border-earth-300 px-4 py-2 text-earth-900 font-mono text-sm focus:outline-none focus:border-earth-800 transition-colors"></textarea>
          </div>

          <div class="flex gap-4">
            <button type="submit" id="submit-btn" class="flex-grow bg-earth-800 text-earth-100 py-4 uppercase tracking-[0.2em] text-sm font-bold hover:bg-earth-700 transition-all shadow-lg">
                Deploy to Outpost
            </button>
            <button type="button" id="delete-btn" class="hidden bg-red-900/10 text-red-900 border border-red-900/20 px-6 py-4 uppercase tracking-[0.2em] text-xs font-bold hover:bg-red-900 hover:text-white transition-all">
                Delete
            </button>
          </div>
        </form>

        <div id="status" class="mt-4 text-sm italic hidden"></div>
      </div>
    </section>

    <section class="space-y-6 animate-fade-up" style="animation-delay: 200ms;">
      <div class="flex justify-between items-center border-b border-earth-300 pb-2">
        <h2 class="text-xs uppercase tracking-[0.2em] text-earth-500 font-bold">Recent Records</h2>
        <div class="flex gap-4">
            <button id="view-posts" class="text-[10px] uppercase tracking-widest text-earth-800 font-bold underline">Journal</button>
            <button id="view-portfolio" class="text-[10px] uppercase tracking-widest text-earth-400 font-bold hover:text-earth-800 transition-colors">Portfolio</button>
            <button id="view-places" class="text-[10px] uppercase tracking-widest text-earth-400 font-bold hover:text-earth-800 transition-colors">Atlas</button>
        </div>
      </div>
      <div id="records-list" class="space-y-4">
        <p class="text-earth-400 italic text-sm">Synchronizing with D1 database...</p>
      </div>
    </section>
  </main>

  <script>
    const authWall = document.getElementById('auth-wall');
    const authInput = document.getElementById('access-key-input');
    const authBtn = document.getElementById('auth-btn');
    const logoutBtn = document.getElementById('logout-btn');

    const deleteBtn = document.getElementById('delete-btn');

    const form = document.getElementById('admin-form');
    const formTitle = document.getElementById('form-title');
    const cancelEditBtn = document.getElementById('cancel-edit');
    const recordIdInput = (document.getElementById('record-id') as HTMLInputElement);
    const existingImagePathInput = (document.getElementById('existing-image-path') as HTMLInputElement);
    const currentImagePreview = document.getElementById('current-image-preview');
    const previewImg = (document.getElementById('preview-img') as HTMLImageElement);

    const typeSelect = (document.getElementById('type') as HTMLSelectElement);
    const titleLabel = document.getElementById('title-label');
    const extraLabel = document.getElementById('extra-label');
    const extraInput = (document.getElementById('extra') as HTMLInputElement);
    const standardFields = document.getElementById('standard-fields');
    const placeFields = document.getElementById('place-fields');
    const status = document.getElementById('status');
    const recordsList = document.getElementById('records-list');
    
    const viewPostsBtn = document.getElementById('view-posts');
    const viewPortfolioBtn = document.getElementById('view-portfolio');
    const viewPlacesBtn = document.getElementById('view-places');

    let currentView = 'post';

    // Simple Auth Logic
    const getStoredKey = () => localStorage.getItem('outpost_admin_key');
    const setStoredKey = (key) => localStorage.setItem('outpost_admin_key', key);

    const checkAuth = () => {
        const key = getStoredKey();
        if (!key) {
            authWall.classList.remove('hidden');
        } else {
            authWall.classList.add('hidden');
            fetchRecords();
        }
    };

    authBtn.addEventListener('click', () => {
        if (authInput.value) {
            setStoredKey(authInput.value);
            checkAuth();
        }
    });

    logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('outpost_admin_key');
        location.reload();
    });

    checkAuth();

    typeSelect.addEventListener('change', () => {
        const type = typeSelect.value;
        if (type === 'place') {
            titleLabel.textContent = 'Location Name';
            standardFields.classList.add('hidden');
            placeFields.classList.remove('hidden');
            (document.getElementById('slug') as HTMLInputElement).required = false;
        } else {
            titleLabel.textContent = 'Title';
            standardFields.classList.remove('hidden');
            placeFields.classList.add('hidden');
            (document.getElementById('slug') as HTMLInputElement).required = true;
            extraLabel.textContent = type === 'portfolio' ? 'Project Year' : 'Extra (Optional)';
            extraInput.placeholder = type === 'portfolio' ? '2026' : '';
        }
    });

    const setView = (view) => {
        currentView = view;
        [viewPostsBtn, viewPortfolioBtn, viewPlacesBtn].forEach(btn => {
            if (btn.id === `view-${view}s` || btn.id === `view-${view}`) {
                btn.classList.add('underline', 'text-earth-800');
                btn.classList.remove('text-earth-400');
            } else {
                btn.classList.remove('underline', 'text-earth-800');
                btn.classList.add('text-earth-400');
            }
        });
        fetchRecords();
    };

    viewPostsBtn.addEventListener('click', () => setView('post'));
    viewPortfolioBtn.addEventListener('click', () => setView('portfolio'));
    viewPlacesBtn.addEventListener('click', () => setView('place'));

    async function fetchRecords() {
      if (!getStoredKey()) return;
      recordsList.innerHTML = '<p class="text-earth-400 italic text-sm">Syncing...</p>';
      try {
        const res = await fetch(`/api/posts?type=${currentView}`);
        const data = await res.json();
        if (data.error) throw new Error(data.error);

        recordsList.innerHTML = data.map(p => `
          <div class="flex justify-between items-center py-3 border-b border-earth-200 group hover:bg-earth-200/20 px-2 transition-colors cursor-pointer" onclick="window.editRecord('${p.id}', '${currentView}')">
            <span class="text-earth-800 font-light">${p.title || p.name}</span>
            <div class="flex gap-4 items-center">
              <span class="text-[10px] uppercase tracking-widest text-earth-400 italic">${currentView === 'place' ? `${p.lat}, ${p.lng}` : (currentView === 'post' ? new Date(p.pubDate).toLocaleDateString() : p.year)}</span>
              <span class="text-[10px] text-earth-500 opacity-0 group-hover:opacity-100 transition-opacity">Click to Edit &rarr;</span>
            </div>
          </div>
        `).join('') || '<p class="text-earth-400 italic">No records found.</p>';
      } catch (err) {
        recordsList.innerHTML = '<p class="text-red-500 italic">Failed to fetch records.</p>';
      }
    }

    (window as any).editRecord = async (id, type) => {
        status.classList.remove('hidden');
        status.textContent = 'Fetching record details...';
        status.className = 'mt-4 text-sm italic text-earth-600';
        
        try {
            const res = await fetch(`/api/posts?id=${id}&type=${type}`);
            const record = await res.json();
            
            (form as HTMLFormElement).reset();
            recordIdInput.value = record.id;
            typeSelect.value = type;
            typeSelect.dispatchEvent(new Event('change'));
            
            (document.getElementById('title') as HTMLInputElement).value = record.title || record.name || '';
            (document.getElementById('content') as HTMLTextAreaElement).value = record.content || '';
            
            if (type === 'place') {
                (document.getElementById('lat') as HTMLInputElement).value = record.lat || '';
                (document.getElementById('lng') as HTMLInputElement).value = record.lng || '';
            } else {
                (document.getElementById('slug') as HTMLInputElement).value = record.slug || '';
                (document.getElementById('description') as HTMLTextAreaElement).value = record.description || '';
                (document.getElementById('extra') as HTMLInputElement).value = record.year || '';
            }

            if (record.image_path) {
                existingImagePathInput.value = record.image_path;
                previewImg.src = `/api/media?path=${record.image_path}`;
                currentImagePreview.classList.remove('hidden');
            } else {
                currentImagePreview.classList.add('hidden');
            }

            formTitle.textContent = `Editing ${type === 'place' ? 'Pin' : 'Entry'}: ${record.title || record.name}`;
            cancelEditBtn.classList.remove('hidden');
            deleteBtn.classList.remove('hidden');
            document.getElementById('submit-btn').textContent = 'Update Outpost';
            status.classList.add('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
            status.textContent = 'Error fetching record.';
            status.className = 'mt-4 text-sm italic text-red-600';
        }
    };

    cancelEditBtn.addEventListener('click', () => {
        (form as HTMLFormElement).reset();
        recordIdInput.value = '';
        existingImagePathInput.value = '';
        currentImagePreview.classList.add('hidden');
        formTitle.textContent = 'Create New Entry';
        cancelEditBtn.classList.add('hidden');
        deleteBtn.classList.add('hidden');
        document.getElementById('submit-btn').textContent = 'Deploy to Outpost';
        typeSelect.dispatchEvent(new Event('change'));
    });

    deleteBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to permanently remove this from the outpost?')) return;
        
        status.classList.remove('hidden');
        status.textContent = 'Removing from cloud...';
        status.className = 'mt-4 text-sm italic text-red-600';

        try {
            const res = await fetch(`/api/posts?id=${recordIdInput.value}&type=${typeSelect.value}&key=${getStoredKey()}`, {
                method: 'DELETE'
            });
            const result = await res.json();

            if (result.success) {
                status.textContent = 'Record successfully removed.';
                cancelEditBtn.click();
                fetchRecords();
            } else {
                throw new Error(result.error);
            }
        } catch (err) {
            status.textContent = 'Error deleting: ' + err.message;
        }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.remove('hidden');
      status.textContent = 'Uploading to Outpost Cloud...';
      status.className = 'mt-4 text-sm italic text-earth-600';

      const formData = new FormData(form);
      formData.append('key', getStoredKey());

      try {
        const res = await fetch('/api/posts', {
          method: 'POST',
          body: formData
        });
        const result = await res.json();

        if (result.success) {
          status.textContent = 'Success! Your changes are live.';
          status.className = 'mt-4 text-sm italic text-green-600 font-bold';
          cancelEditBtn.click();
          fetchRecords();
        } else {
          throw new Error(result.error);
        }
      } catch (err) {
        status.textContent = 'Error: ' + err.message;
        status.className = 'mt-4 text-sm italic text-red-600';
        if (err.message === 'Unauthorized Access') {
            localStorage.removeItem('outpost_admin_key');
            location.reload();
        }
      }
    });
  </script>
</Layout>
