---
import Layout from '../layouts/Layout.astro';
import FlowArt from '../components/ui/FlowArt.astro';
import FlowSection from '../components/ui/FlowSection.astro';
import LogoMark from '../components/ui/LogoMark.astro';
---

<Layout title="Hugo Lau">
  <FlowArt aria-label="Hugo Lau — Personal Showcase">
    <!-- 01 — Intro -->
    <FlowSection
      aria-label="Hello"
      style={{ 'background-color': '#FD5200', color: '#ffffff' }}
    >
      <div class="flex items-center gap-[1.2vw]">
        <LogoMark class="h-[1.6vw] min-h-4 w-auto text-black" />
        <p class="text-xs font-bold uppercase tracking-[0.2em]">01 — Hello, I'm Hugo</p>
      </div>
      <hr class="my-[2vw] border-0 border-t border-black opacity-100" />
      <div>
        <h1 class="text-[clamp(3.5rem,12vw,14rem)] font-extrabold leading-[0.85] uppercase tracking-tight">
          Code
          <br />
          As
          <br />
          Craft
        </h1>
      </div>
      <hr class="my-[2vw] border-0 border-t border-black opacity-100" />
      <p class="text-balance mt-auto max-w-[50ch] text-[clamp(1rem,2.5vw,2rem)] font-normal leading-relaxed">
        I'm a software engineer building elegant, performant, user-centric
        digital experiences — where design and technology meet.
      </p>
    </FlowSection>

    <!-- 02 — What I do -->
    <FlowSection
      aria-label="What I do"
      style={{ 'background-color': '#000000', color: '#ffffff' }}
    >
      <p class="text-xs font-bold uppercase tracking-[0.2em]">02 — What I do</p>
      <hr class="my-[2vw] border-0 border-t border-white/60" />
      <div>
        <h2 class="text-[clamp(3.5rem,12vw,14rem)] font-extrabold leading-[0.85] uppercase tracking-tight">
          Build
          <br />
          With
          <br />
          Intent
        </h2>
      </div>
      <hr class="my-[2vw] border-0 border-t border-white/60" />
      <div class="flex flex-wrap gap-[3vw]">
        <div class="min-w-[180px] flex-1">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">AI Engineering</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75">
            LLM-powered tools end to end — from AI coaches to MCP servers that
            give models direct access to real-world data.
          </p>
        </div>
        <div class="min-w-[180px] flex-1">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">Developer Tools</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75">
            CLIs and TUIs in Go and Python that sharpen everyday workflows —
            commits, providers, pipelines.
          </p>
        </div>
        <div class="min-w-[180px] flex-1">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">Web Craft</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75">
            Fast, editorial web experiences built with Astro and TypeScript —
            typography, rhythm and motion as first-class citizens.
          </p>
        </div>
      </div>
      <hr class="my-[2vw] border-0 border-t border-white/60" />
      <p class="text-balance mt-auto ml-auto max-w-[50ch] text-right text-[clamp(1rem,2.5vw,2rem)] font-normal leading-relaxed">
        Every project starts with one question — does this serve the person
        using it?
      </p>
    </FlowSection>

    <!-- 03 — Selected work -->
    <FlowSection
      aria-label="Selected work"
      style={{ 'background-color': '#F5F0E8', color: '#000000' }}
    >
      <p class="text-xs font-bold uppercase tracking-[0.2em]">03 — Selected work</p>
      <hr class="my-[2vw] border-0 border-t border-black/60" />
      <div>
        <h2 class="text-[clamp(3.5rem,12vw,14rem)] font-extrabold leading-[0.85] uppercase tracking-tight">
          Things
          <br />
          I've
          <br />
          Made
        </h2>
      </div>
      <hr class="my-[2vw] border-0 border-t border-black/60" />
      <div class="flex flex-wrap gap-[3vw]">
        <a
          href="https://github.com/hluaguo/learn-faster-kit"
          target="_blank"
          rel="noopener noreferrer"
          class="group min-w-[180px] flex-1"
        >
          <p class="mb-2 flex items-baseline justify-between gap-2 text-sm font-bold uppercase tracking-wider">
            <span>01 — Learn Faster Kit</span>
            <span class="font-normal opacity-50">370 ★</span>
          </p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75 transition-opacity duration-500 group-hover:opacity-100">
            AI-powered learning coach with spaced repetition, built on Claude
            Code. Personalized syllabi and progress tracking to master any
            knowledge faster.
          </p>
          <span class="mt-3 inline-block text-[10px] font-bold uppercase tracking-[0.2em] opacity-0 transition-opacity duration-500 group-hover:opacity-70">
            View on GitHub →
          </span>
        </a>
        <a
          href="https://github.com/hluaguo/metabase-mcp"
          target="_blank"
          rel="noopener noreferrer"
          class="group min-w-[180px] flex-1"
        >
          <p class="mb-2 flex items-baseline justify-between gap-2 text-sm font-bold uppercase tracking-wider">
            <span>02 — Metabase MCP</span>
            <span class="font-normal opacity-50">72 ★</span>
          </p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75 transition-opacity duration-500 group-hover:opacity-100">
            MCP server bridging Metabase and conversational AI — letting LLMs
            query your analytics data directly, no dashboards required.
          </p>
          <span class="mt-3 inline-block text-[10px] font-bold uppercase tracking-[0.2em] opacity-0 transition-opacity duration-500 group-hover:opacity-70">
            View on GitHub →
          </span>
        </a>
        <a
          href="https://github.com/hluaguo/commity"
          target="_blank"
          rel="noopener noreferrer"
          class="group min-w-[180px] flex-1"
        >
          <p class="mb-2 flex items-baseline justify-between gap-2 text-sm font-bold uppercase tracking-wider">
            <span>03 — Commity</span>
            <span class="font-normal opacity-50">Go</span>
          </p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75 transition-opacity duration-500 group-hover:opacity-100">
            AI-powered git commit generator with a TUI. Select files, generate
            conventional commits, and split changes — all from the terminal.
          </p>
          <span class="mt-3 inline-block text-[10px] font-bold uppercase tracking-[0.2em] opacity-0 transition-opacity duration-500 group-hover:opacity-70">
            View on GitHub →
          </span>
        </a>
      </div>
      <hr class="my-[2vw] border-0 border-t border-black/60" />
      <div class="flex flex-wrap gap-[3vw]">
        <a
          href="https://github.com/hluaguo/omni-provider"
          target="_blank"
          rel="noopener noreferrer"
          class="group min-w-[180px] flex-1"
        >
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">04 — Omni Provider</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75 transition-opacity duration-500 group-hover:opacity-100">
            A small, unified Go interface for OpenAI, Anthropic and Google
            Gemini. One API, every major model.
          </p>
        </a>
      </div>

      <!-- Animated "And more" — full-bleed infinite marquee linking to GitHub -->
      <a
        href="https://github.com/hluaguo?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="And more projects on GitHub"
        class="group -mx-[4vw] mt-[2vw] block overflow-hidden border-y-2 border-black py-[1.2vw]"
      >
        <div class="flex w-max animate-marquee transition-colors duration-500 group-hover:text-[#1A3DE8] group-hover:[animation-play-state:paused]">
          {Array.from({ length: 12 }).map(() => (
            <span class="flex shrink-0 items-center gap-[2vw] pr-[3vw] text-[clamp(2rem,5vw,5rem)] font-extrabold uppercase leading-none tracking-tight">
              And more
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-[0.65em] shrink-0"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </span>
          ))}
        </div>
      </a>
    </FlowSection>

    <!-- 04 — Now / Numbers -->
    <FlowSection
      aria-label="Now"
      style={{ 'background-color': '#1A3DE8', color: '#ffffff' }}
    >
      <p class="text-xs font-bold uppercase tracking-[0.2em]">04 — Right now</p>
      <hr class="my-[2vw] border-0 border-t border-white/50" />
      <div>
        <h2 class="text-[clamp(3.5rem,12vw,14rem)] font-extrabold leading-[0.85] uppercase tracking-tight">
          Always
          <br />
          In
          <br />
          Motion
        </h2>
      </div>
      <hr class="my-[2vw] border-0 border-t border-white/50" />
      <div class="flex flex-wrap gap-[3vw]">
        <div class="min-w-[180px] flex-1">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">Building</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75">
            AI-powered learning and analytics tools — making LLMs genuinely
            useful in daily workflows.
          </p>
        </div>
        <div class="min-w-[180px] flex-1">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">Learning</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75">
            Agentic workflows, MCP and everything happening at the frontier of
            AI tooling.
          </p>
        </div>
        <div class="min-w-[180px] flex-1">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider">Open To</p>
          <p class="text-[clamp(0.85rem,1.3vw,1.05rem)] leading-relaxed opacity-75">
            Collaborations, interesting problems and good conversations.
          </p>
        </div>
      </div>
    </FlowSection>

    <!-- 05 — Contact -->
    <FlowSection
      aria-label="Contact"
      style={{ 'background-color': '#000000', color: '#ffffff' }}
    >
      <LogoMark class="h-[5vw] min-h-10 w-auto text-[#FD5200]" />
      <p class="text-xs font-bold uppercase tracking-[0.2em]">05 — Say hello</p>
      <hr class="my-[2vw] border-0 border-t border-white/60" />
      <div>
        <h2 class="text-[clamp(3.5rem,12vw,14rem)] font-extrabold leading-[0.85] uppercase tracking-tight">
          Let's
          <br />
          Talk.
        </h2>
      </div>
      <hr class="my-[2vw] border-0 border-t border-white/60" />
      <p class="mt-auto max-w-[50ch] text-[clamp(1rem,2.5vw,2rem)] font-normal leading-relaxed">
        Have a project in mind, or just want to say hi? My inbox is always
        open.
      </p>
      <div class="mt-[2vw] flex flex-wrap gap-[2vw]">
        <a
          href="mailto:cheukyin175@gmail.com"
          class="w-fit border border-white px-8 py-4 text-xs font-bold uppercase tracking-[0.25em] transition-colors duration-500 hover:bg-white hover:text-black"
        >
          cheukyin175@gmail.com
        </a>
        <a
          href="https://github.com/hluaguo"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit border border-white/40 px-8 py-4 text-xs font-bold uppercase tracking-[0.25em] transition-colors duration-500 hover:border-white hover:bg-white hover:text-black"
        >
          GitHub — @hluaguo
        </a>
      </div>
    </FlowSection>
  </FlowArt>
</Layout>
