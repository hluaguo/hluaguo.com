---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Journal - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-4xl mx-auto px-6 md:px-12 py-12 md:py-24 relative z-10">
    
    <header class="mb-16 md:mb-24 text-center animate-fade-up" style="animation-delay: 200ms;">
      <h1 class="text-5xl md:text-7xl font-light text-earth-900 tracking-tight mb-4">Journal</h1>
      <p class="text-lg text-earth-600 font-light italic max-w-lg mx-auto">
        Chronicles of architecture, design, and aimless wandering.
      </p>
      <div class="w-px h-16 bg-earth-300 mx-auto mt-12"></div>
    </header>

    <div class="space-y-16">
      {posts.map((post, index) => (
        <article class="group relative animate-fade-up" style={`animation-delay: ${300 + (index * 150)}ms;`}>
          <!-- Decorative subtle date marker behind text -->
          <div class="hidden md:block absolute -left-24 top-2 text-earth-300 font-light text-sm italic origin-left -rotate-90">
            {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </div>

          <a href={`/blog/${post.id}`} class="block space-y-4">
            <div class="flex items-baseline gap-4 mb-2">
              <time datetime={post.data.pubDate.toISOString()} class="text-xs uppercase tracking-widest text-earth-500 font-medium">
                {post.data.pubDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' })}
              </time>
              <div class="h-[1px] flex-grow bg-earth-200 group-hover:bg-earth-400 transition-colors"></div>
            </div>
            
            <h2 class="text-3xl md:text-4xl font-light text-earth-900 group-hover:italic transition-all duration-500">
              {post.data.title}
            </h2>
            
            <p class="text-earth-700 font-light text-lg leading-relaxed max-w-2xl">
              {post.data.description}
            </p>
            
            {post.data.tags && (
              <div class="flex gap-4 pt-2">
                {post.data.tags.map(tag => (
                  <span class="text-xs italic text-earth-500 hover:text-earth-800 transition-colors">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>

  </main>
</Layout>
