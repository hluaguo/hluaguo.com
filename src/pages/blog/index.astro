---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { env } from 'cloudflare:workers';

const db = (env as any).OUTPOST_DB;

let posts = [];
try {
  const { results } = await db.prepare('SELECT * FROM posts WHERE is_published = 1 ORDER BY pubDate DESC').all();
  posts = results;
} catch (e) {
  console.error('D1 Fetch Error:', e);
}
---

<Layout title="Journal - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-4xl mx-auto px-6 md:px-12 py-12 md:py-24 relative z-10">
    
    <header class="mb-16 md:mb-24 text-center animate-fade-up" style="animation-delay: 200ms;">
      <h1 class="text-5xl md:text-7xl font-light text-earth-900 tracking-tight mb-4">Journal</h1>
      <p class="text-lg text-earth-600 font-light italic max-w-lg mx-auto">
        Chronicles of architecture, design, and aimless wandering.
      </p>
      <div class="w-px h-16 bg-earth-300 mx-auto mt-12"></div>
    </header>

    <div class="space-y-16">
      {posts.length > 0 ? posts.map((post, index) => (
        <article class="group relative animate-fade-up" style={`animation-delay: ${300 + (index * 150)}ms;`}>
          <a href={`/blog/${post.slug}`} class="block space-y-4">
            <div class="flex items-baseline gap-4 mb-2">
              <time datetime={new Date(post.pubDate).toISOString()} class="text-xs uppercase tracking-widest text-earth-500 font-medium">
                {new Date(post.pubDate).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' })}
              </time>
              <div class="h-[1px] flex-grow bg-earth-200 group-hover:bg-earth-400 transition-colors"></div>
            </div>
            
            <h2 class="text-3xl md:text-4xl font-light text-earth-900 group-hover:italic transition-all duration-500">
              {post.title}
            </h2>
            
            {post.image_path && (
                <div class="w-full h-64 md:h-80 overflow-hidden border border-earth-300">
                    <img src={`/api/media?path=${post.image_path}`} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" />
                </div>
            )}

            <p class="text-earth-700 font-light text-lg leading-relaxed max-w-2xl">
              {post.description}
            </p>
          </a>
        </article>
      )) : (
        <div class="text-center py-20 text-earth-400 italic">
          The outpost journal is currently empty. 
          <br/> Check back after the next expedition.
        </div>
      )}
    </div>

  </main>
</Layout>
