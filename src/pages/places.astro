---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Map from '../components/Map.tsx';
---

<Layout title="Explored Places - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-24 z-10 relative">
    
    <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-16 animate-fade-up" style="animation-delay: 200ms;">
      <div class="space-y-4 max-w-2xl">
        <h1 class="text-6xl md:text-8xl font-serif font-light text-earth-900 tracking-tight">Atlas</h1>
        <p class="text-xl md:text-2xl text-earth-600 font-light italic">
          A collection of coordinates, memories, and wanderings.
        </p>
      </div>
      <div class="text-[10px] uppercase tracking-[0.25em] text-earth-500 font-bold md:text-right border-l md:border-l-0 md:border-r border-clay/30 pl-4 md:pl-0 md:pr-4">
        Global <br /> Perspectives
      </div>
    </header>

    <div class="relative z-0 p-2 md:p-4 glass-earth rounded-sm shadow-2xl shadow-earth-800/5 animate-fade-in" style="animation-delay: 400ms;">
      <div class="relative overflow-hidden rounded-sm border border-earth-300 aspect-[16/9] md:aspect-auto md:h-[600px]">
        <Map client:only="react" />
      </div>
    </div>

    <div class="mt-8 flex justify-between items-center text-[10px] uppercase tracking-[0.2em] text-earth-400 font-bold animate-fade-up" style="animation-delay: 500ms;">
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-clay animate-pulse"></span>
        Latitude & Longitude
      </span>
      <span>Live Outpost Map</span>
    </div>

  </main>
</Layout>
