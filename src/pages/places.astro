---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Map from '../components/Map.tsx';
---

<Layout title="Explored Places - Hugo Lau">
  <Navigation />
  <main class="flex-grow w-full max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-24 z-10 relative">
    
    <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-16 animate-fade-up" style="animation-delay: 200ms;">
      <div class="space-y-4 max-w-2xl">
        <h1 class="text-5xl md:text-7xl font-light text-earth-900 tracking-tight">Atlas</h1>
        <p class="text-xl md:text-2xl text-earth-700 font-light italic">
          A collection of coordinates, memories, and wanderings.
        </p>
      </div>
      <div class="text-xs uppercase tracking-[0.2em] text-earth-500 font-medium text-right">
        Global <br /> Perspectives
      </div>
    </header>

    <div class="relative z-0 p-3 md:p-6 glass-earth rounded-sm shadow-2xl shadow-earth-800/10 animate-fade-in hover-lift" style="animation-delay: 400ms;">
      <div class="relative overflow-hidden rounded-sm border border-earth-300">
        <Map client:only="react" />
      </div>
    </div>

    <div class="mt-8 flex justify-between items-center text-xs uppercase tracking-[0.2em] text-earth-500 animate-fade-up" style="animation-delay: 500ms;">
      <span>Latitude & Longitude</span>
      <span>Live Map</span>
    </div>

  </main>
</Layout>
