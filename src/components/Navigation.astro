---
const navItems = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/blog', label: 'Journal' },
  { href: '/places', label: 'Atlas' },
];
---

<nav class="w-full pt-12 pb-6 px-6 md:px-12 z-40 relative animate-fade-in" style="animation-delay: 100ms;">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-end gap-8 border-b border-earth-800 pb-6">
    <a href="/" class="group flex flex-col gap-1">
      <span class="text-3xl md:text-4xl font-light tracking-tight text-earth-900 group-hover:italic transition-all duration-500">Hugo Lau</span>
      <span class="text-xs tracking-[0.2em] uppercase text-earth-600 font-medium">Digital Outpost &mdash; Est. 2026</span>
    </a>
    <ul class="flex gap-8 md:gap-12">
      {navItems.map((item, i) => (
        <li class="relative group" style={`animation-delay: ${200 + i * 100}ms;`} class="animate-fade-up">
          <a href={item.href} class="text-sm tracking-widest uppercase text-earth-700 hover:text-earth-900 font-medium transition-colors block py-2">
            {item.label}
          </a>
          <!-- Minimal animated underline -->
          <div class="absolute bottom-0 left-0 w-0 h-[1px] bg-earth-900 group-hover:w-full transition-all duration-500 ease-out"></div>
        </li>
      ))}
    </ul>
  </div>
</nav>
