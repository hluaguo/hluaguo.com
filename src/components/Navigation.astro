---
const navItems = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/blog', label: 'Journal' },
  { href: '/places', label: 'Atlas' },
];
---

<nav class="w-full pt-12 pb-6 px-8 md:px-16 lg:px-24 z-40 relative animate-fade-in" style="animation-delay: 100ms;">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-end gap-8 border-b border-earth-300 pb-8">
    <div class="flex flex-col md:flex-row md:items-end gap-4 md:gap-12">
      <a href="/" class="group flex flex-col gap-1">
        <span class="text-3xl md:text-4xl font-light tracking-tight text-earth-900 group-hover:italic transition-all duration-500">Lau Cheuk Yin, Hugo</span>
        <span class="text-xs tracking-[0.2em] uppercase text-earth-600 font-medium">Software Engineer</span>
      </a>
    </div>

    <ul class="flex gap-8 md:gap-12">
      {navItems.map((item, i) => (
        <li class="relative group" style={`animation-delay: ${200 + i * 100}ms;`} class="animate-fade-up">
          <a href={item.href} class="text-sm tracking-widest uppercase text-earth-700 hover:text-earth-900 font-medium transition-colors block py-2">
            {item.label}
          </a>
          <!-- Minimal animated underline -->
          <div class="absolute bottom-0 left-0 w-0 h-[1px] bg-earth-900 group-hover:w-full transition-all duration-500 ease-out"></div>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  function updateTime() {
    const timeEl = document.getElementById('local-time');
    if (timeEl) {
      const now = new Date();
      timeEl.textContent = now.toLocaleTimeString('en-US', { 
        hour12: false, 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit' 
      }) + ' UTC';
    }
  }
  
  updateTime();
  setInterval(updateTime, 1000);
  
  // Re-run on Astro page transitions
  document.addEventListener('astro:page-load', updateTime);
</script>
