---
---
<div id="mouse-glow" class="pointer-events-none fixed inset-0 z-[1] opacity-0 transition-opacity duration-700" style="--mouse-x: 50%; --mouse-y: 50%;"></div>

<style>
  #mouse-glow {
    background: radial-gradient(
      400px circle at var(--mouse-x) var(--mouse-y),
      rgba(198, 167, 141, 0.15),
      transparent 80%
    );
  }
</style>

<script>
  const glow = document.getElementById('mouse-glow');
  
  if (glow) {
    const updateGlow = (e: MouseEvent) => {
      glow.style.opacity = '1';
      glow.style.setProperty('--mouse-x', `${e.clientX}px`);
      glow.style.setProperty('--mouse-y', `${e.clientY}px`);
    };

    window.addEventListener('mousemove', updateGlow);
    
    // Also update on scroll if mouse is still
    window.addEventListener('scroll', () => {
      glow.style.opacity = '1';
    });

    // Fade out when mouse leaves window
    document.addEventListener('mouseleave', () => {
      glow.style.opacity = '0';
    });
  }
</script>
