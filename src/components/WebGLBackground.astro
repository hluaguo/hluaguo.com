---
---
<div id="webgl-bg-container" class="fixed inset-0 z-0 pointer-events-none mix-blend-multiply opacity-[0.25]"></div>

<script>
  import * as THREE from 'three';

  function initWebGL() {
    const container = document.getElementById('webgl-bg-container');
    if (!container) return;

    // Clear existing canvas if any
    while (container.firstChild) {
      container.removeChild(container.firstChild);
    }

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const geometry = new THREE.PlaneGeometry(2, 2);

    const vertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 1.0);
      }
    `;

    // Fluid Ink Wash Shader using Domain Warping and FBM
    const fragmentShader = `
      uniform float uTime;
      uniform vec2 uMouse;
      uniform vec2 uResolution;
      varying vec2 vUv;

      // 2D Random
      float random (in vec2 st) {
          return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
      }

      // 2D Noise based on Morgan McGuire @morgan3d
      float noise (in vec2 st) {
          vec2 i = floor(st);
          vec2 f = fract(st);

          // Four corners in 2D of a tile
          float a = random(i);
          float b = random(i + vec2(1.0, 0.0));
          float c = random(i + vec2(0.0, 1.0));
          float d = random(i + vec2(1.0, 1.0));

          // Smooth Interpolation
          vec2 u = f*f*(3.0-2.0*f);

          // Mix 4 corners percentages
          return mix(a, b, u.x) +
                  (c - a)* u.y * (1.0 - u.x) +
                  (d - b) * u.x * u.y;
      }

      // Fractional Brownian Motion
      #define OCTAVES 5
      float fbm (in vec2 st) {
          float value = 0.0;
          float amplitude = .5;
          float frequency = 0.;
          vec2 shift = vec2(100.0);
          // Rotate to reduce axial bias
          mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.50));
          for (int i = 0; i < OCTAVES; i++) {
              value += amplitude * noise(st);
              st = rot * st * 2.0 + shift;
              amplitude *= 0.5;
          }
          return value;
      }

      void main() {
        vec2 uv = vUv;
        // Fix aspect ratio
        uv.x *= uResolution.x / uResolution.y;

        // Normalize mouse coordinates
        vec2 mouse = uMouse;
        mouse.x *= uResolution.x / uResolution.y;

        // Mouse interaction: push the fluid away
        float distToMouse = length(uv - mouse);
        vec2 mouseDir = normalize(uv - mouse);
        float mouseForce = exp(-distToMouse * 4.0); // Smooth falloff

        // Base coordinate scaling
        vec2 p = uv * 3.0;
        
        // Time variables for slow, organic flow
        float t = uTime * 0.15;

        // Apply mouse force to warp the space
        p += mouseDir * mouseForce * 0.5;

        // Domain Warping technique
        vec2 q = vec2(0.);
        q.x = fbm(p + vec2(0.0, 0.0) + t);
        q.y = fbm(p + vec2(5.2, 1.3) + t * 0.8);

        vec2 r = vec2(0.);
        r.x = fbm(p + 4.0 * q + vec2(1.7, 9.2) + t * 1.5);
        r.y = fbm(p + 4.0 * q + vec2(8.3, 2.8) + t * 1.2);

        float f = fbm(p + 4.0 * r);

        // Map the noise value to our earth tones
        // --color-earth-100: #f4f0ea -> 244, 240, 234 (Transparent background)
        // --color-earth-300: #d0bdae -> 208, 189, 174
        // --color-earth-400: #bca08d -> 188, 160, 141
        // --color-earth-600: #8c6753 -> 140, 103, 83

        vec3 colorBg = vec3(244., 240., 234.) / 255.0;
        vec3 color1 = vec3(208., 189., 174.) / 255.0; // earth-300
        vec3 color2 = vec3(188., 160., 141.) / 255.0; // earth-400
        vec3 color3 = vec3(140., 103., 83.) / 255.0;  // earth-600

        // Mix colors based on the noise value (f) and warped vectors (q, r)
        vec3 color = mix(color1, color2, clamp((f*f)*4.0, 0.0, 1.0));
        color = mix(color, color3, clamp(length(q), 0.0, 1.0));
        color = mix(color, colorBg, clamp(length(r.x), 0.0, 1.0));

        // Create an alpha mask based on the noise so it blends nicely over the site background
        // Darker ink spots are more opaque, lighter areas are transparent
        float alpha = (f * f * f + 0.6 * f * f + 0.5 * f);
        
        // Boost alpha slightly where the mouse interacts
        alpha += mouseForce * 0.3;

        // Smooth output
        gl_FragColor = vec4(color, alpha * 0.8);
      }
    `;

    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms: {
        uTime: { value: 0.0 },
        // Start mouse off-screen
        uMouse: { value: new THREE.Vector2(-10, -10) },
        uResolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) }
      },
      transparent: true,
      depthWrite: false,
    });

    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let targetMouse = new THREE.Vector2(-10, -10);
    let currentMouse = new THREE.Vector2(-10, -10);
    // Flag to know if mouse has entered the screen
    let hasMoved = false;

    const onMouseMove = (event: MouseEvent) => {
      hasMoved = true;
      // Convert to normalized 0.0 to 1.0 range for the shader UV matching
      targetMouse.x = event.clientX / window.innerWidth;
      // Flip Y for WebGL coordinates
      targetMouse.y = 1.0 - (event.clientY / window.innerHeight);
    };
    window.addEventListener('mousemove', onMouseMove);

    const onWindowResize = () => {
      renderer.setSize(window.innerWidth, window.innerHeight);
      material.uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
    };
    window.addEventListener('resize', onWindowResize);

    let animationFrameId: number;
    const clock = new THREE.Clock();

    const animate = () => {
      animationFrameId = requestAnimationFrame(animate);
      
      material.uniforms.uTime.value = clock.getElapsedTime();

      if (hasMoved) {
        // Smooth mouse spring effect
        currentMouse.x += (targetMouse.x - currentMouse.x) * 0.05;
        currentMouse.y += (targetMouse.y - currentMouse.y) * 0.05;
        material.uniforms.uMouse.value.copy(currentMouse);
      }

      renderer.render(scene, camera);
    };

    animate();

    // Clean up on View Transitions
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('resize', onWindowResize);
      window.removeEventListener('mousemove', onMouseMove);
      cancelAnimationFrame(animationFrameId);
      geometry.dispose();
      material.dispose();
      renderer.dispose();
    }, { once: true });
  }

  // Initialize on first load
  initWebGL();

  // Re-initialize after Astro view transitions if the canvas is gone
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('#webgl-bg-container > canvas')) {
      initWebGL();
    }
  });
</script>
